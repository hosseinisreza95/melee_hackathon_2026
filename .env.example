# Copy to .env and fill in. Never commit .env. No value here is required to run the collectors,
# parsers, database or API read endpoints; the AI key is only needed for /ask and label extraction.
APP_ENV=development

# Database: SQLite file by default; PostgreSQL on the team server, e.g.
# DATABASE_URL=postgresql+psycopg://lpc:lpc@localhost:5432/lpc_regwatch
DATABASE_URL=

# AI provider. Default: Claude (Sonnet 5.5) through the Anthropic SDK. Switch provider by changing these lines only.
#   Claude:        AI_PROVIDER=anthropic     AI_MODEL=claude-sonnet-5-5      key in CLAUDE_API_KEY (also read: CLOUDE_API_KEY, ANTHROPIC_API_KEY, AI_API_KEY)
#   OpenAI:        AI_PROVIDER=openai        AI_BASE_URL=                                   AI_MODEL=gpt-5-mini     key in AI_API_KEY (or OPENAI_API_KEY / OPEN_AI)
#   Gemini:        AI_PROVIDER=gemini        AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.0-flash
#   Azure OpenAI:  AI_PROVIDER=azure_openai  AI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/           AI_MODEL=<deployment-name>
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5     # answers (/ask) and label extraction
CLAUDE_API_KEY=
AI_API_KEY=            # only for the non-Claude providers
AI_BASE_URL=
AI_REASONING_EFFORT=low        # Claude: low | medium | high ; gpt-5: minimal | low | medium | high

# Collectors
HTTP_USER_AGENT=lpc-regwatch/0.1 (regulatory watch)
RAW_DIR=data/raw

# Deployment
FR_EPHY_SCOPE=all                       # lallemand = pilots + Lallemand holders + pilot species | all = every AUTORISE product in France (+ Lallemand ones of any status)
PIPELINE_SCHEDULE=30 3 * * *            # cron (UTC) of the nightly collect->parse->normalize job, shown in the UI
API_BASE_URL=http://localhost:8000      # where the Streamlit UI reaches the API (inside docker: http://api:8000)
PUBLIC_BASE_URL=http://localhost:8000   # public URL advertised in /openapi.json (for the M365 connector)
POSTGRES_PASSWORD=change-me

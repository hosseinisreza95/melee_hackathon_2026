# Copy to .env and fill in. Never commit .env. No value here is required to run the collectors,
# parsers, database or API read endpoints; the AI key is only needed for /ask and label extraction.
APP_ENV=development

# Database: SQLite file by default; PostgreSQL on the team server, e.g.
# DATABASE_URL=postgresql+psycopg://lpc:lpc@localhost:5432/lpc_regwatch
DATABASE_URL=

# AI provider — any OpenAI-compatible endpoint. Switch provider by changing these 4 lines only.
#   OpenAI:        AI_PROVIDER=openai        AI_BASE_URL=                                   AI_MODEL=gpt-4o-mini
#   Gemini:        AI_PROVIDER=gemini        AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.0-flash
#   Azure OpenAI:  AI_PROVIDER=azure_openai  AI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/           AI_MODEL=<deployment-name>
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=

# Collectors
HTTP_USER_AGENT=lpc-regwatch/0.1 (hackathon prototype)
RAW_DIR=data/raw
